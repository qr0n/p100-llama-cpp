-        const T_src d_low = ggml_cuda_cast<T_src>(dst[i]);
-        dst[i] = ggml_cuda_cast<T_dst>(
-            ggml_cuda_cast<float>(d_low) + ggml_cuda_cast<float>(src[i]));
+        float sum = 0.0f;
