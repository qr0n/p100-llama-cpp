+void ggml_cuda_gp100_softplus_bias_mul(ggml_backend_cuda_context & ctx, const float * x, const float * b, const float * a,
+                                       float * dst, int n) {
+    gp100_softplus_bias_mul<<<(n + 255) / 256, 256, 0, ctx.stream()>>>(x, b, a, dst, n);
+}
