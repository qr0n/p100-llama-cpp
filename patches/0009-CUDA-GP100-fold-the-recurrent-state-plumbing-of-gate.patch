+    dst[i] = ((v > 20.0f) ? v : logf(1.0f + expf(v))) * a[i];
+#else
+    GGML_UNUSED_VARS(x, b, a, dst, n);
+    NO_DEVICE_CODE;
+#endif // __CUDA_ARCH__ == GGML_CUDA_CC_PASCAL
+}
